# Copy to .env on the VM. Never commit the populated .env.

# Public host, no scheme. Example: postiz.example.com
POSTIZ_HOST=postiz.example.com

# Current Postiz core
MAIN_URL=https://postiz.example.com
FRONTEND_URL=https://postiz.example.com
NEXT_PUBLIC_BACKEND_URL=https://postiz.example.com/api
BACKEND_INTERNAL_URL=http://localhost:3000
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_64
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@SERVER.postgres.database.azure.com:5432/postiz?sslmode=require
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:PORT
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
IS_GENERAL=true
DISABLE_REGISTRATION=false
RUN_CRON=true
API_LIMIT=90

# Storage. Local works; R2 is recommended for public media-heavy use.
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/uploads
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKETNAME=
# CLOUDFLARE_BUCKET_URL=
# CLOUDFLARE_REGION=auto

# Native providers requested by this project
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TELEGRAM_BOT_NAME=
TELEGRAM_TOKEN=

# Optional Postiz AI feature. Not needed for the external ChatGPT/Grok bridge.
# OPENAI_API_KEY=

# Never set NOT_SECURED=true in production.

# AI compatibility bridge (create Postiz API key after owner signup, then fill this)
POSTIZ_API_KEY=
BRIDGE_API_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Optional WhatsApp Cloud API adapter
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
